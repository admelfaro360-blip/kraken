{
  "entities": {
    "Budget": {
      "title": "Budget",
      "description": "Presupuesto de servicios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "total": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientId", "total", "date", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Cliente del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vertical": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "clientType": { "type": "string" }
      },
      "required": ["id", "name", "vertical", "address", "phone"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Orden de trabajo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "budgetId": { "type": "string" },
        "clientId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "budgetId", "clientId", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Registro de cobro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "budgetId": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "budgetId", "amount"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Gasto del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "description", "amount"]
    },
    "User": {
      "title": "User",
      "description": "Usuario del sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "allowedModules": { "type": "array" }
      },
      "required": ["id", "role"]
    },
    "AgendaNote": {
      "title": "AgendaNote",
      "description": "Nota o recordatorio en la agenda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "date"]
    },
    "MaintenanceRecord": {
      "title": "MaintenanceRecord",
      "description": "Ficha de mantenimiento preventivo checklist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientData": { "type": "object" },
        "date": { "type": "string" },
        "nextRevisionDate": { "type": "string" },
        "checklist": { "type": "array" },
        "generalObservations": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientId", "date", "status", "checklist"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehículo de la empresa y sus datos de mantenimiento",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "plate": { "type": "string" },
        "currentKm": { "type": "number" },
        "kmPerMonth": { "type": "number" }
      },
      "required": ["id", "brand", "model", "plate", "currentKm", "kmPerMonth"]
    }
  },
  "firestore": {
    "budgets": {
      "schema": "Budget",
      "description": "Colección de presupuestos"
    },
    "clients": {
      "schema": "Client",
      "description": "Colección de clientes"
    },
    "work_orders": {
      "schema": "WorkOrder",
      "description": "Colección de órdenes de trabajo"
    },
    "payments": {
      "schema": "Payment",
      "description": "Colección de cobros"
    },
    "expenses": {
      "schema": "Expense",
      "description": "Colección de gastos"
    },
    "config": {
      "schema": "object",
      "description": "Configuración global"
    },
    "users": {
      "schema": "User",
      "description": "Colección de usuarios"
    },
    "agenda_notes": {
      "schema": "AgendaNote",
      "description": "Colección de notas de la agenda"
    },
    "maintenance": {
      "schema": "MaintenanceRecord",
      "description": "Colección de registros de mantenimiento preventivo"
    },
    "agreements": {
      "schema": "ClientAgreement",
      "description": "Colección de convenios"
    },
    "vehicles": {
      "schema": "Vehicle",
      "description": "Colección de vehículos de la empresa y su ficha de mantenimiento"
    }
  }
}
