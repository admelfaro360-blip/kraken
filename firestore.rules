rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla global de denegación por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == "admelfaro360@gmail.com" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Colección de Usuarios: Permitir lectura para el login manual
    match /users/{userId} {
      allow read: if true;
      allow create: if (isAuthenticated() && (request.auth.uid == userId || isAdmin())) || (userId == "admelfaro360@gmail.com");
      allow update, delete: if isAdmin();
    }

    // Otras colecciones
    match /budgets/{id} { allow read, write: if isAuthenticated(); }
    match /clients/{id} { allow read, write: if isAuthenticated(); }
    match /work_orders/{id} { allow read, write: if isAuthenticated(); }
    match /payments/{id} { allow read, write: if isAuthenticated(); }
    match /expenses/{id} { allow read, write: if isAuthenticated(); }
    match /employees/{id} { allow read, write: if isAuthenticated(); }
    
    match /config/business {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
